{
  "name": "audyssey",
  "version": "0.1.0",
  "description": "Compare published npm packages with their source repositories and explain every difference.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run start --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspace web",
    "analyze": "node server/bin/audyssey.js analyze",
    "watch": "node server/bin/audyssey.js watch"
  }
}
